<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.medicare">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_hospital_cross"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_hospital_cross"
        android:supportsRtl="true"
        android:theme="@style/Theme.Medicare"
        tools:targetApi="31">

        <!-- Initial Screen: MEDICARE Hospital Management System with [Login] and [Create Account] -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".DoctorDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".BookAppointmentActivity"
            android:exported="false" />

        <activity
            android:name=".AppointmentsActivity"
            android:exported="false" />

        <activity
            android:name=".DoctorsActivity"
            android:exported="false" />

        <activity
            android:name=".DoctorDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".PatientProfileActivity"
            android:exported="false" />

        <activity
            android:name=".PatientsActivity"
            android:exported="false" />

        <activity
            android:name=".DoctorAppointmentsActivity"
            android:exported="false" />

        <activity
            android:name=".DoctorAppointmentDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".DoctorProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ManageDoctorsActivity"
            android:exported="false" />

        <activity
            android:name=".AddEditDoctorActivity"
            android:exported="false" />

        <activity
            android:name=".AdminAppointmentsActivity"
            android:exported="false" />

        <activity
            android:name=".AdminAppointmentDetailsActivity"
            android:exported="false" />

    </application>

</manifest>
